services:
  app:
    build: .
    ports:
      - "8080:8080"
    environment:
      - APP_ENV=development
    volumes:
      - ./config:/app/config
{{- if eq .database "postgres"}}
    depends_on:
      postgres:
        condition: service_healthy

  postgres:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: secret
      POSTGRES_DB: {{.service_name}}
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app"]
      interval: 5s
      timeout: 5s
      retries: 5
{{- end}}
{{- if eq .database "mysql"}}
    depends_on:
      mysql:
        condition: service_healthy

  mysql:
    image: mysql:8-debian
    environment:
      MYSQL_ROOT_PASSWORD: secret
      MYSQL_DATABASE: {{.service_name}}
      MYSQL_USER: app
      MYSQL_PASSWORD: secret
    ports:
      - "3306:3306"
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 5s
      timeout: 5s
      retries: 5
{{- end}}
{{- if eq .database "mongodb"}}
    depends_on:
      - mongo

  mongo:
    image: mongo:7
    ports:
      - "27017:27017"
{{- end}}
